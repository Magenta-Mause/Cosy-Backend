# Cosy-Backend environment variables (example)
# Copy to `.env` and adjust. NEVER commit real secrets.
#
# These map to the ${...} placeholders in src/main/resources/application.yaml.
# Spring Boot binds them via relaxed environment binding. Any value left unset
# falls back to the (development-only) default shown in application.yaml.

# --- Security ---
# JWT signing key. MUST be set for any non-local deployment.
#
# Base64-encoded, >= 32 bytes once decoded: the value is Base64-decoded at
# startup, so a plain passphrase dies with `DecodingException: Illegal base64
# character`. Generate one with:
#
#     openssl rand -base64 48
#
# Left commented out on purpose. An *empty* value is not the same as unset —
# Spring resolves `${COSY_JWT_SECRET_KEY:<default>}` to the empty string and
# startup fails with a WeakKeyException, whereas leaving it unset falls back to
# the development default in application.yaml.
#COSY_JWT_SECRET_KEY=

# --- Grafana Loki (server logs) ---
COSY_LOKI_USER=loki-user
COSY_LOKI_PASSWORD=loki-password

# --- InfluxDB (metrics) ---
COSY_INFLUX_TOKEN=cosy-admin-token

# --- Docker engine (game server runtime) ---
# Docker socket. On Windows use e.g. npipe:////./pipe/docker_engine
COSY_DOCKER_SOCKET_PATH=unix:///var/run/docker.sock
# Host directory used for game server bind mounts
COSY_DOCKER_VOLUME_DIRECTORY=./dummy/cosy/volume-mounts
# Path the backend itself uses to reach those mounts
COSY_DOCKER_BACKEND_VOLUME_MOUNT_PATH=./dummy/cosy/volume-mounts
# Prefix applied to managed container names
COSY_DOCKER_CONTAINER_PREFIX=cosy-
# Periodic safety net that re-derives persisted game server status from real
# container state, so a dropped status event cannot leave a server stuck in a
# transitional status. How often the sweep runs (ms):
COSY_ENGINE_RECONCILIATION_INTERVAL_MS=180000
# How long a server that recently entered a transitional status is left alone,
# so the sweep cannot fight an in-flight start or stop (ms):
COSY_ENGINE_RECONCILIATION_GRACE_PERIOD_MS=60000

# --- Footer / imprint (shown in the UI) ---
# Values containing spaces are quoted so the file stays safe to `source` from a
# shell. Note that `docker run --env-file` does not strip quotes — drop them if
# you feed this file to Docker directly.
COSY_FOOTER_FULL_NAME="Full Name"
COSY_FOOTER_EMAIL=yourEmail@example.org
COSY_FOOTER_PHONE="+49 123 4567890"
COSY_FOOTER_STREET="Street 5"
COSY_FOOTER_CITY="12345 City"
