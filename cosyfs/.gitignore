# =========================
# Rust
# =========================

# Cargo build output
/target/

# Backup files generated by rustfmt / editors
**/*.rs.bk

# If this is a library crate (it is), KEEP Cargo.lock.
# If it were a binary app, you would commit Cargo.lock.
# So we explicitly DO NOT ignore Cargo.lock here.


# =========================
# Generated artifacts
# =========================

# Compiled dynamic libraries (just in case someone builds outside target/)
*.so
*.dylib
*.dll
*.a

# Dependency metadata
*.d
*.rlib
*.rmeta


# =========================
# Tooling / IDE
# =========================

# VSCode
.vscode/

# IntelliJ / RustRover / CLion
.idea/
*.iml

# Flycheck (you have flycheck0/)
flycheck*
/target/flycheck*


# =========================
# OS noise
# =========================

.DS_Store
Thumbs.db


# =========================
# Coverage / profiling
# =========================

*.profraw
*.profdata
coverage/
